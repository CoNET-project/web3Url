{
  "manifest_version": 3,
  "name": "CoNET Web3 Gateway",
  "version": "0.1.0",
  "description": "Safari Web Extension wrapper for the CoNET Web3 Gateway.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["pageBridge.js"],
    "run_at": "document_start"
  }],
  "action": { "default_title": "CoNET Web3 Gateway" }
}
