# Generated on the conet.network host. Do not commit the populated file.
CONET_RPC_URL=https://rpc1.conet.network
GATEWAY_EOA=0x<official-gateway-eoa>
GATEWAY_ETH_PRIVATE_KEY_FILE=/etc/conet-web3-gateway/secrets/gateway.eth
GATEWAY_PGP_PRIVATE_KEY_FILE=/etc/conet-web3-gateway/secrets/gateway-pgp.asc
GATEWAY_ENTRY_URLS=https://<entry-a>.conet.network,https://<entry-c>.conet.network
GATEWAY_UPSTREAM_ORIGIN=https://conet.network
