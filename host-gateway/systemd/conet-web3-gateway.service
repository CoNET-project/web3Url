[Unit]
Description=CoNET official web3:// host gateway
Documentation=https://gitbook.conet.network/applications/web3-url.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conet-gateway
Group=conet-gateway
WorkingDirectory=/opt/conet-web3-gateway
EnvironmentFile=/etc/conet-web3-gateway.env
ExecStart=/usr/bin/node /opt/conet-web3-gateway/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/conet-web3-gateway
UMask=0077

[Install]
WantedBy=multi-user.target
